{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "whoisawake",
	"compatibility_date": "2026-08-12",
	"assets": {
		"directory": "./dist",
		"not_found_handling": "404-page"
	},
	"env": {
		"dev": {
			"name": "whoisawake-dev",
			"assets": {
				"directory": "./dist",
				"not_found_handling": "404-page"
			}
		}
	}
}